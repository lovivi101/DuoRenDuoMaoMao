def make_background(name):
    w,h=1334,750; im=Image.new('RGB',(w,h)); px=im.load();
    palettes={'bg-splash-dorm-night':((11,14,35),(48,32,84)),'bg-login-dorm-gate':((18,20,48),(75,47,85)),'bg-lobby-dorm-hall':((20,24,55),(71,50,90)),'bg-matching-corridor':((11,18,42),(42,42,82)),'bg-room-waiting-hall':((22,19,52),(67,42,77)),'bg-role-reveal-dark':((6,8,25),(35,20,65)),'bg-map-vote-blueprint':((17,31,59),(31,67,92)),'bg-result-dawn':((65,39,58),(203,116,84)),'bg-menu-dim':((10,10,28),(34,25,57))}
    a,b=palettes.get(name,((10,10,28),(34,25,57)))
    for y in range(h):
        t=y/(h-1)
        col=tuple(int(a[i]*(1-t)+b[i]*t) for i in range(3))
        for x in range(w): px[x,y]=col
    d=ImageDraw.Draw(im); random_seed=abs(hash(name))%1000
    for x in range(70,w,120):
        d.rectangle((x,180,x+70,600),fill=(12,14,37)); d.rectangle((x+12,220,x+58,275),fill=(255,200,87)); d.rectangle((x+12,330,x+58,385),fill=(84,93,152))
    d.rectangle((0,610,w,750),fill=(14,15,35));
    for x in range(0,w,64): d.line((x,610,x+32,750),fill=(35,28,66),width=2)
    return im


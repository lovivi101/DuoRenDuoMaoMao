def split_generated(sheet, names, cat, out_size):
    im=Image.open(sheet).convert('RGBA'); W,H=im.size; cols=4; rows=4
    for i,n in enumerate(names):
        x0=i%cols*W//cols; y0=i//cols*H//rows; x1=(i%cols+1)*W//cols; y1=(i//cols+1)*H//rows
        cell=im.crop((x0,y0,x1,y1)); a=np.asarray(cell); ys,xs=np.where(a[:,:,3]>8)
        if len(xs): cell=cell.crop((max(0,xs.min()-4),max(0,ys.min()-4),min(cell.width,xs.max()+5),min(cell.height,ys.max()+5)))
        save_if_missing(n,cat,fit(cell,out_size))

